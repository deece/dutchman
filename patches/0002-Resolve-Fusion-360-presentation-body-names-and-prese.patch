+/// Fusion archives record body names in `BulkStream.dat` presentations beside their visual GUID.
+/// When cadmpeg's body-suffix matching misses a body whose suffix changed across edits, match
+/// it by its assigned appearance visual GUID or remaining unused presentation order.
+fn resolve_f3d_presentation_names(ir: &mut cadmpeg_ir::CadIr, bytes: &[u8]) {
+    if !ir.model.bodies.iter().any(|b| b.name.is_none()) {
+        return;
+    }
+
+    let arena = cadmpeg_core::decode::DecodeArena::new();
+    let policy = cadmpeg_core::decode::DecodePolicy::default();
+    let Ok((ctx, root)) =
+        cadmpeg_core::decode::DecodeContext::from_root_bytes(bytes, &arena, &policy)
+    else {
+        return;
+    };
+    let Ok(snapshot) = cadmpeg_container::ArchiveSnapshot::new(&ctx, root) else {
+        return;
+    };
+
+    let mut presentations = Vec::new();
+    for entry in snapshot.entries() {
+        if entry.name.ends_with("BulkStream.dat") {
+            if let Ok(view) = snapshot.open(&ctx, &entry.name) {
+                extract_f3d_presentations(view.window(), &mut presentations);
+            }
+        }
+    }
+
+    if presentations.is_empty() {
+        return;
+    }
+
+    use cadmpeg_ir::appearance::AppearanceTarget;
+    let mut body_guids = std::collections::HashMap::new();
+    for binding in &ir.model.appearance_bindings {
+        let AppearanceTarget::Body(body_id) = &binding.target else {
+            continue;
+        };
+        let app_str = binding.appearance.as_str();
+        if let Some((_, guid)) = app_str.split_once('#') {
+            let clean_guid = guid.strip_suffix("_Post2015").unwrap_or(guid);
+            body_guids.insert(body_id.clone(), clean_guid.to_ascii_uppercase());
+        }
+    }
+
+    let mut used_names = std::collections::HashSet::new();
+    for body in ir.model.bodies.iter().filter_map(|b| b.name.as_ref()) {
+        used_names.insert(body.clone());
+    }
+
+    for body in &mut ir.model.bodies {
+        if body.name.is_some() {
+            continue;
+        }
+        if let Some(guid) = body_guids.get(&body.id) {
+            if let Some((name, _)) = presentations
+                .iter()
+                .find(|(name, p_guid)| p_guid == guid && !used_names.contains(name))
+            {
+                body.name = Some(name.clone());
+                used_names.insert(name.clone());
+            }
+        }
+    }
+
+    let remaining_unnamed: Vec<_> = ir
+        .model
+        .bodies
+        .iter_mut()
+        .filter(|b| b.name.is_none() && b.kind == cadmpeg_ir::topology::BodyKind::Solid)
+        .collect();
+
+    let mut unused_pres: Vec<_> = presentations
+        .iter()
+        .map(|(name, _)| name.clone())
+        .filter(|name| !used_names.contains(name))
+        .collect();
+    unused_pres.dedup();
+
+    for (body, name) in remaining_unnamed.into_iter().zip(unused_pres) {
+        body.name = Some(name);
+    }
+}
+
+fn extract_f3d_presentations(data: &[u8], presentations: &mut Vec<(String, String)>) {
+    const PATTERN: &[u8] = b"\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x24\x00\x00\x00";
+    let mut offset = 0;
+    while offset + PATTERN.len() + 72 <= data.len() {
+        let Some(window) = data.get(offset..) else {
+            break;
+        };
+        if let Some(pos) = window
+            .windows(PATTERN.len())
+            .position(|w| w == PATTERN)
+        {
+            let idx = offset + pos;
+            let guid_start = idx + PATTERN.len();
+            let guid_end = guid_start + 72;
+            if let Some(guid_bytes) = data.get(guid_start..guid_end) {
+                let guid: String = std::char::decode_utf16(
+                    guid_bytes
+                        .as_chunks::<2>()
+                        .0
+                        .iter()
+                        .map(|c| u16::from_le_bytes(*c)),
+                )
+                .filter_map(Result::ok)
+                .collect();
+
+                if guid.len() == 36 && guid.contains('-') {
+                    let min_back = idx.saturating_sub(120);
+                    let max_back = idx.saturating_sub(16);
+                    for back in (min_back..max_back).rev() {
+                        let Some(len_bytes) = data.get(back..back + 4) else {
+                            continue;
+                        };
+                        let Ok(arr) = <[u8; 4]>::try_from(len_bytes) else {
+                            continue;
+                        };
+                        let len = u32::from_le_bytes(arr) as usize;
+                        if (1..=64).contains(&len) {
+                            let str_start = back + 4;
+                            let str_end = str_start + len * 2;
+                            if str_end <= idx {
+                                if let Some(str_bytes) = data.get(str_start..str_end) {
+                                    let name: String = std::char::decode_utf16(
+                                        str_bytes
+                                            .as_chunks::<2>()
+                                            .0
+                                            .iter()
+                                            .map(|c| u16::from_le_bytes(*c)),
+                                    )
+                                    .filter_map(Result::ok)
+                                    .collect();
+
+                                    if name.len() == len
+                                        && name.chars().all(|c| !c.is_control())
+                                        && !name.starts_with("Prism")
+                                    {
+                                        presentations.push((name, guid.to_ascii_uppercase()));
+                                        break;
+                                    }
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+            offset = idx + PATTERN.len();
+        } else {
+            break;
+        }
+    }
+}
